# Cloudflare Worker (workers/api)
# Copy as workers/api/.dev.vars for local wrangler dev.
# Admin auth is handled by Cloudflare Access path rules in production; do not put admin secrets in the browser bundle.

# R2 public URL. Used for uploaded media URLs returned by the Worker.
PUBLIC_R2_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# CORS origins allowed to call this Worker. Separate multiple origins with comma.
ALLOWED_ORIGIN=http://localhost:5174,http://localhost:5173,https://virtual-museum-admin.pages.dev,https://virtual-museum-web.pages.dev

# Admin SPA (apps/admin)
# Copy as apps/admin/.env.local

# Worker API URL. Admin calls /api/draft, /api/upload, /api/publish, and /api/stats here.
VITE_API_URL=http://localhost:8787

# Optional: R2 public URL so admin previews production assets consistently.
# VITE_ASSET_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Web app (apps/web)
# Copy as apps/web/.env.local

# Sample mode (GitHub Pages / static demo):
# - no VITE_ASSET_BASE_URL required
# - app reads content/content.sample.json and content/models/* from the repo
# - set VITE_BASE_URL if deployed under a sub-path
# VITE_BASE_URL=/VR-Museum-SSO/

# Cloudflare mode (production):
# - app reads:
#   <VITE_ASSET_BASE_URL>/content.json
#   <VITE_ASSET_BASE_URL>/content/models/*.glb
#   <VITE_ASSET_BASE_URL>/content/documents/*
VITE_ASSET_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Worker API URL. Web calls public visitor counting endpoints here.
VITE_API_URL=https://virtual-museum-api.your-account.workers.dev
